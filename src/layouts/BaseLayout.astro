---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { ViewTransitions } from "astro:transitions";
import Posthog from "../components/Posthog.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Nikolay Kost — JavaScript Developer. Building for the web since 2013.",
} = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <link
      rel="alternate"
      hreflang="ru"
      href="https://artkost.ru"
    />
    <link
      rel="alternate"
      hreflang="en"
      href="https://artkost.dev"
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://artkost.dev" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Opengraph Meta Tags -->
    <meta property="og:url" content="https://artkost.dev/">
    <meta property="og:url" lang="ru" content="https://artkost.dev/">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Nikolay Kost - JavaScript Developer">
    <meta property="og:title" lang="ru" content="Николай Костюрин — JavaScript Разработчик">
    <meta property="og:description" content="Nikolay Kost - JavaScript Developer specializing in web applications and efficient JavaScript solutions">
    <meta property="og:description" lang="ru" content="Николай Костюрин — разработчик JavaScript, специализирующийся на веб-приложениях и эффективных решениях JavaScript">

    <meta property="og:image" content="android-chrome-192x192.png">

    <!-- Twitter Meta Tags -->
    <meta property="twitter:domain" content="artkost.dev">
    <meta property="twitter:domain" lang="ru" content="artkost.ru">
    <meta property="twitter:url" content="https://artkost.dev/">
    <meta property="twitter:url" lang="ru" content="https://artkost.ru/">
    <meta name="twitter:site" content="@jilizart">

    <meta name="twitter:description" content="I specialize in building exceptional web applications and creating efficient JavaScript solutions. Currently focusing on exciting new projects and open-source contributions. ✨">
    <meta name="twitter:description" lang="ru" content="Я специализируюсь на создании исключительных веб-приложений и создании эффективных решений JavaScript. В настоящее время сосредоточен на новых интересных проектах и ​​вкладах в open-source. ✨">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Nikolay Kost - JavaScript Developer">
    <meta name="twitter:title" lang="ru" content="Nikolay Костюрин - JavaScript Разработчик">
    <meta name="twitter:image" content="android-chrome-192x192.png">
    <meta name="twitter:image:alt" content="Nikolay Kost - JavaScript Developer">
    <meta name="twitter:image:alt" lang="ru" content="Nikolay Костюрин - JavaScript Разработчик">

    <meta name="ahrefs-site-verification" content="02bbece82fd93f7352123d0b2fdca15b55b6cdf90e672bb28d5456458fafcf37">

    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

    <!-- Pre-paint theme: read localStorage and apply class before first paint -->
    <script is:inline>
      (function () {
        try {
          const saved = JSON.parse(localStorage.getItem("__tweaks") || "{}");
          const theme = saved.theme || "light";
          const isDark = theme === "dark" ||
            (theme === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);
          if (isDark) document.documentElement.classList.add("dark");
          if (saved.accentHue != null) {
            const h = saved.accentHue;
            const root = document.documentElement;
            if (h === 0) {
              root.style.setProperty("--accent", isDark ? "oklch(0.85 0 0)" : "oklch(0.25 0 0)");
              root.style.setProperty("--accent-2", isDark ? "oklch(0.7 0 0)" : "oklch(0.4 0 0)");
            } else {
              root.style.setProperty("--accent-h", h);
              root.style.setProperty("--accent", `oklch(0.62 0.17 ${h})`);
              root.style.setProperty("--accent-2", `oklch(0.74 0.13 ${h})`);
            }
          }
        } catch (e) {}
      })();
    </script>

    <ViewTransitions />
  </head>
  <body>
    <Navbar />
    <main class="wrap-wide">
      <slot />
    </main>
    <SiteFooter />
  </body>
  <Posthog />
  <script type="application/ld+json" lang="en">
      {
          "@context": "https://json-ld.org/contexts/person.jsonld",
          "name": "Nikolay Kosturin",
          "nickname": "jilizart",
          "born": "1989-12-29",
          "email": "mailto:nk@artkost.dev",
          "url": "https://artkost.dev",
          "jobTitle": "JavaScript Developer",
          "image": "https://artkost.dev/profile.jpeg",
          "homepage": "https://artkost.dev",
          "sameAs": [
          "https://github.com/jilizart",
          "https://x.com/jilizart",
          "https://linkedin.com/in/nkostyurin",
          "https://t.me/jilizart",
          "https://twitter.com/jilizart"
      ]
      }
  </script>
  <script type="application/ld+json" lang="ru">
      {
          "@context": "https://json-ld.org/contexts/person.jsonld",
          "name": "Николай Костюрин",
          "nickname": "jilizart",
          "born": "1989-12-29",
          "email": "mailto:nk@artkost.ru",
          "url": "https://artkost.ru",
          "jobTitle": "JavaScript Разработчик",
          "image": "https://artkost.ru/profile.jpeg",
          "homepage": "https://artkost.ru",
          "sameAs": [
          "https://github.com/jilizart",
          "https://x.com/jilizart",
          "https://linkedin.com/in/nkostyurin",
          "https://t.me/jilizart",
          "https://twitter.com/jilizart"
      ]
      }
  </script>
</html>
