---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { ViewTransitions } from "astro:transitions";
import Posthog from "../components/Posthog.astro";
import { t, LANG } from "@/helpers/t";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = t("meta.homeTitle"),
  description = t("meta.defaultDescription"),
} = Astro.props;

const canonical = LANG === "ru" ? "https://artkost.ru" : "https://artkost.dev";
const ogLocale = LANG === "ru" ? "ru_RU" : "en_US";
const twitterDomain = LANG === "ru" ? "artkost.ru" : "artkost.dev";

const personLd = LANG === "ru"
  ? {
      "@context": "https://json-ld.org/contexts/person.jsonld",
      name: "Николай Костюрин",
      nickname: "jilizart",
      born: "1989-12-29",
      email: "mailto:nk@artkost.ru",
      url: "https://artkost.ru",
      jobTitle: "JavaScript Разработчик",
      image: "https://artkost.ru/profile.jpeg",
      homepage: "https://artkost.ru",
      sameAs: [
        "https://github.com/jilizart",
        "https://x.com/jilizart",
        "https://linkedin.com/in/nkostyurin",
        "https://t.me/jilizart",
        "https://twitter.com/jilizart",
      ],
    }
  : {
      "@context": "https://json-ld.org/contexts/person.jsonld",
      name: "Nikolay Kosturin",
      nickname: "jilizart",
      born: "1989-12-29",
      email: "mailto:nk@artkost.dev",
      url: "https://artkost.dev",
      jobTitle: "JavaScript Developer",
      image: "https://artkost.dev/profile.jpeg",
      homepage: "https://artkost.dev",
      sameAs: [
        "https://github.com/jilizart",
        "https://x.com/jilizart",
        "https://linkedin.com/in/nkostyurin",
        "https://t.me/jilizart",
        "https://twitter.com/jilizart",
      ],
    };
---

<!doctype html>
<html lang={LANG} class="font-sans font-['Inter']">
  <head>
    <link rel="alternate" hreflang="ru" href="https://artkost.ru" />
    <link rel="alternate" hreflang="en" href="https://artkost.dev" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Opengraph Meta Tags -->
    <meta property="og:url" content={canonical + "/"} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={t("meta.ogTitle")} />
    <meta property="og:description" content={t("meta.ogDescription")} />
    <meta property="og:image" content="android-chrome-192x192.png" />

    <!-- Twitter Meta Tags -->
    <meta property="twitter:domain" content={twitterDomain} />
    <meta property="twitter:url" content={canonical + "/"} />
    <meta name="twitter:site" content="@jilizart" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={t("meta.twitterTitle")} />
    <meta name="twitter:description" content={t("meta.twitterDescription")} />
    <meta name="twitter:image" content="android-chrome-192x192.png" />
    <meta name="twitter:image:alt" content={t("meta.twitterImageAlt")} />

    <meta name="ahrefs-site-verification" content="02bbece82fd93f7352123d0b2fdca15b55b6cdf90e672bb28d5456458fafcf37">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Pre-paint lang flip: hostname-based, runs before first paint. -->
    <script is:inline>
      (function () {
        try {
          var isRu = location.hostname.toLowerCase().endsWith(".ru");
          document.documentElement.lang = isRu ? "ru" : "en";
          var setAttr = function (sel, attr, val) {
            var el = document.querySelector(sel);
            if (el) el.setAttribute(attr, val);
          };
          var origin = isRu ? "https://artkost.ru" : "https://artkost.dev";
          var domain = isRu ? "artkost.ru" : "artkost.dev";
          setAttr('link[rel="canonical"]', "href", origin);
          setAttr('meta[property="og:locale"]', "content", isRu ? "ru_RU" : "en_US");
          setAttr('meta[property="og:url"]', "content", origin + "/");
          setAttr('meta[property="twitter:domain"]', "content", domain);
          setAttr('meta[property="twitter:url"]', "content", origin + "/");
        } catch (e) {}
      })();
    </script>

    <!-- Pre-paint theme: read localStorage and apply class before first paint -->
    <script is:inline>
      (function () {
        try {
          const saved = JSON.parse(localStorage.getItem("__tweaks") || "{}");
          const theme = saved.theme || "light";
          const isDark = theme === "dark" ||
            (theme === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);
          if (isDark) document.documentElement.classList.add("dark");
          if (saved.accentHue != null) {
            const h = saved.accentHue;
            const root = document.documentElement;
            if (h === 0) {
              root.style.setProperty("--accent", isDark ? "oklch(0.85 0 0)" : "oklch(0.25 0 0)");
              root.style.setProperty("--accent-2", isDark ? "oklch(0.7 0 0)" : "oklch(0.4 0 0)");
            } else {
              root.style.setProperty("--accent-h", h);
              root.style.setProperty("--accent", `oklch(0.62 0.17 ${h})`);
              root.style.setProperty("--accent-2", `oklch(0.74 0.13 ${h})`);
            }
          }
        } catch (e) {}
      })();
    </script>

    <ViewTransitions />
  </head>
  <body>
    <Navbar />
    <main class="wrap-wide">
      <slot />
    </main>
    <SiteFooter />
  </body>
  <Posthog />
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
</html>
