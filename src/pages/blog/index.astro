---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostsSearch from "../../islands/PostsSearch.tsx";
import { getCollection } from "astro:content";
import { t } from "@/helpers/t";

const all = await getCollection("posts", ({ data }) => !data.draft);
const posts = all
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => ({
    slug: p.slug,
    title: p.data.title,
    excerpt: p.data.excerpt,
    date: p.data.date.toISOString(),
    tag: p.data.tag,
    readTime: p.data.readTime,
  }));
---
<BaseLayout title={t("blog.metaTitle")} description={t("blog.metaDescription")}>
  <section id="posts-index" class="section-spaced posts-index">
    <a href="/" class="post-back">{t("blog.back")}</a>
    <div class="eyebrow" style="margin-top: 24px;">{t("blog.eyebrow")}</div>
    <h1 class="h1" style="margin: 8px 0 12px; font-size: clamp(38px, 5vw, 64px);">{t("blog.title")}</h1>
    <p class="body-l" style="max-width: 620px; margin: 0 0 36px; color: var(--ink-2);">{t("blog.lede")}</p>

    <PostsSearch posts={posts} client:load />
  </section>
</BaseLayout>
