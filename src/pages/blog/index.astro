---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostsSearch from "../../islands/PostsSearch.tsx";
import { getCollection } from "astro:content";

const all = await getCollection("posts", ({ data }) => !data.draft);
const posts = all
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => ({
    slug: p.slug,
    title: p.data.title,
    excerpt: p.data.excerpt,
    date: p.data.date.toISOString(),
    tag: p.data.tag,
    readTime: p.data.readTime,
  }));
---
<BaseLayout title="Writing — Nikolay Kost" description="Long-form essays on frontend infrastructure, open source, and shipping software that holds up.">
  <section id="posts-index" class="section-spaced posts-index">
    <a href="/" class="post-back">← Back to home</a>
    <div class="eyebrow" style="margin-top: 24px;">Writing</div>
    <h1 class="h1" style="margin: 8px 0 12px; font-size: clamp(38px, 5vw, 64px);">
      Notes from the build.
    </h1>
    <p class="body-l" style="max-width: 620px; margin: 0 0 36px; color: var(--ink-2);">
      Long-form essays on frontend infrastructure, open source, and the process of shipping
      software that holds up. Updated when I have something worth saying.
    </p>

    <PostsSearch posts={posts} client:load />
  </section>
</BaseLayout>
