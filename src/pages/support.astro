---
import BaseLayout from "../layouts/BaseLayout.astro";
import CopyButton from "../islands/CopyButton.tsx";
import { CRYPTO_ADDRESSES } from "../data/socials";
import { t } from "@/helpers/t";
---
<BaseLayout title={t("support.metaTitle")} description={t("support.metaDescription")}>
  <div class="support-wrap">
    <a href="/" class="support-back">{t("support.back")}</a>
    <span class="support-eyebrow">{t("support.eyebrow")}</span>
    <h1 class="support-title">{t("support.title")}</h1>
    <p class="support-lede">{t("support.lede")}</p>

    <div class="support-list">
      {CRYPTO_ADDRESSES.map((a) => (
        <div class="support-card">
          <div class={`support-icon ${a.cls}`}>{a.badge}</div>
          <div class="support-info">
            <div class="support-name">
              {a.name} <span class="support-ticker">{a.ticker}</span>
            </div>
            <div class="support-network">{a.network}</div>
            <div class="support-address" title={a.address}>{a.address}</div>
          </div>
          <CopyButton value={a.address} client:visible />
        </div>
      ))}
    </div>

    <div class="support-note">
      <strong>{t("support.noteStrong")}</strong><Fragment set:html={t("support.note")} />
    </div>

    <div class="support-thanks">{t("support.thanks")}</div>
  </div>
</BaseLayout>
