---
import ColorConverter from "../components/ColorConverter";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Color Converter">
  <main id="color-canvas" class="min-w-full min-h-screen self-stretch flex-grow flex items-center transition-colors duration-200">
    <div class="w-full max-w-3xl mx-auto px-6">
      <ColorConverter client:load />
    </div>
  </main>
</BaseLayout>
