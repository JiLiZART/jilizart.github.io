---
// Brand logo SVGs/images for experience cards
interface Props {
  brand: "skyeng" | "muse" | "cube" | "hodl";
}
const { brand } = Astro.props;
---
{brand === "skyeng" && (
  <img src="https://cdn-user84632.skyeng.ru/shared/large-media/skysmart/layout/logo/skyeng-logo-dark.svg" alt="Skyeng" />
)}
{brand === "cube" && (
  <img src="https://cube.dev/favicon.svg" alt="Cube" />
)}
{brand === "hodl" && (
  <img src="https://hodlhodl.com/assets/favicon.svg" alt="HodlHodl" />
)}
{brand === "muse" && (
  <svg width="100%" height="100%" viewBox="0 0 204 59" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M64.86 5.49h4.3v1.84c.42-.65.97-1.19 1.65-1.6.7-.42 1.46-.63 2.27-.63h.2c1.9 0 3.23.85 3.99 2.54.39-.7.96-1.3 1.72-1.8.78-.5 1.66-.74 2.62-.74h.2c1.46 0 2.58.49 3.36 1.49.81.99 1.21 2.46 1.21 4.42V27h-4.46V11.55c0-.78-.17-1.4-.51-1.84-.31-.47-.79-.7-1.45-.7h-.15c-.66 0-1.15.23-1.49.7-.31.44-.47 1.06-.47 1.84V27h-4.46V11.55c0-.78-.17-1.4-.51-1.84-.31-.47-.79-.7-1.45-.7h-.15c-.66 0-1.15.23-1.49.7-.31.44-.47 1.06-.47 1.84V27h-4.46Z" fill="currentColor"/>
    <path fillRule="evenodd" clipRule="evenodd" d="M16.57 5H0L26.84 59H27L16.57 5ZM5 22H0v35h5V22ZM35.38 5.08C38.4 6.86 40.88 10.35 40.88 14.38c0 5.35-3.8 9.54-8.9 9.54-.23 0-.45-.02-.65-.04 3.23-.62 5.67-3.46 5.67-6.87 0-3.87-3.13-7-7-7-3.82 0-6.92 3.06-7 6.85h0c0 .03 0 .05 0 .07 0 .02 0 .05 0 .07 0 2.06.89 3.92 2.31 5.2.5.47 1.05.87 1.65 1.18 2.08 1.16 4.33 1.62 6.96 1.62 8.74 0 15.09-5.66 15.09-13.8 0-2.32-.7-4.96-1.39-6.2H35.38v.08ZM48 29H35v29h13V29Z" fill="currentColor"/>
