---
interface Props {
  constrained?: boolean;
}
const { constrained = false } = Astro.props;
---
<section id="contact" class:list={[constrained && "post-wrap"]}>
  <div class="eyebrow">Get in touch</div>
  <h2 class="h1" style="margin: 8px 0 24px; max-width: 14ch;">Let's make something worth using.</h2>
  <p class="body-l" style="max-width: 560px; margin-bottom: 28px;">
    I'm taking on new frontend and infrastructure work. The fastest way to reach me is email or Telegram — I usually reply within a day.
  </p>
  <div style="display: flex; gap: 12px; flex-wrap: wrap;">
    <a class="btn" href="mailto:nk@artkost.dev">nk@artkost.dev</a>
    <a class="btn ghost" href="https://bit.ly/nkcv">Download CV</a>
  </div>
</section>
