---
import { t } from "@/helpers/t";
interface Props {
  constrained?: boolean;
}
const { constrained = false } = Astro.props;
---
<section id="contact" class:list={[constrained && "post-wrap"]}>
  <div class="eyebrow">{t("contact.eyebrow")}</div>
  <h2 class="h1" style="margin: 8px 0 24px; max-width: 14ch;">{t("contact.title")}</h2>
  <p class="body-l" style="max-width: 560px; margin-bottom: 28px;">{t("contact.body")}</p>
  <div style="display: flex; gap: 12px; flex-wrap: wrap;">
    <a class="btn" href="mailto:nk@artkost.dev">nk@artkost.dev</a>
    <a class="btn ghost" href="https://bit.ly/nkcv">{t("contact.cv")}</a>
  </div>
</section>
