---
import { t } from "@/helpers/t";
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || (p !== "/" && path.startsWith(p));
---
<nav class="nav">
  <div class="nav-inner">
    <div class="nav-brand-wrapper">
      <div class="logo">
        <img loading="eager" src="/profile.jpeg" alt="Nikolay Kost" class="logo-img" />
      </div>
      <a href="/" class="nav-brand">Nikolay Kost</a>
    </div>
    <ul>
      <li><a href="/#overview" class:list={[{ active: isActive("/") && path === "/" }]}>{t("nav.overview")}</a></li>
      <li><a href="/#experience">{t("nav.experience")}</a></li>
      <li><a href="/#crafts">{t("nav.crafts")}</a></li>
      <!--<li><a href="/blog" class:list={[{ active: isActive("/blog") }]}>Blog</a></li>-->
      <li><a href="/support" class:list={[{ active: isActive("/support") }]}>{t("nav.support")}</a></li>
    </ul>
    <a class="nav-cta" href="mailto:nk@artkost.dev">{t("nav.cta")}</a>
  </div>
</nav>

<style>
  .nav ul a.active { color: var(--ink); }
</style>
