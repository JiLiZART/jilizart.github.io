---
import { t } from "@/helpers/t";
---
<section id="crafts" class="section-spaced">
  <div class="eyebrow">{t("crafts.eyebrow")}</div>
  <h2 class="h1" style="margin: 8px 0 36px;">{t("crafts.title")}</h2>

  <div class="crafts">
    <article class="craft craft-bbob">
      <span class="craft-tag">{t("crafts.bbobTag")}</span>
      <h3 set:html={t("crafts.bbobTitle")} />
      <p set:html={t("crafts.bbobP1")} />
      <p set:html={t("crafts.bbobP2")} />
      <div class="pills">
        <span class="pill">javascript</span>
        <span class="pill">react</span>
        <span class="pill">parser</span>
        <span class="pill">ast</span>
      </div>
    </article>

    <article class="craft craft-bnet">
      <span class="craft-tag">{t("crafts.bnetTag")}</span>
      <h3 set:html={t("crafts.bnetTitle")} />
      <p set:html={t("crafts.bnetP1")} />
      <p set:html={t("crafts.bnetP2")} />
      <div class="pills">
        <span class="pill">node.js</span>
        <span class="pill">protocol</span>
        <span class="pill">wireshark</span>
        <span class="pill">ffi</span>
      </div>
    </article>
  </div>
</section>
