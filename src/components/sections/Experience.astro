---
import BrandLogos from "../BrandLogos.astro";
import { t } from "@/helpers/t";
---
<section id="experience" class="section-spaced">
  <div class="eyebrow">{t("experience.eyebrow")}</div>
  <h2 class="h1" style="margin: 8px 0 36px;">{t("experience.title")}</h2>

  <div class="exp-grid">
    <article class="exp-card exp-hodl">
      <div class="exp-card-logo"><BrandLogos brand="hodl" /></div>
      <h3 class="exp-card-title">HodlHodl</h3>
      <p class="exp-card-desc">{t("experience.hodl")}</p>
    </article>
    <article class="exp-card exp-cube">
      <div class="exp-card-logo"><BrandLogos brand="cube" /></div>
      <h3 class="exp-card-title">Cube</h3>
      <p class="exp-card-desc">{t("experience.cube")}</p>
    </article>
    <article class="exp-card exp-muse">
      <div class="exp-card-logo" style="height: 22px;"><BrandLogos brand="muse" /></div>
      <h3 class="exp-card-title">Muse Group</h3>
      <p class="exp-card-desc">{t("experience.muse")}</p>
    </article>
    <article class="exp-card exp-skyeng">
      <div class="exp-card-logo" style="height: 18px;"><BrandLogos brand="skyeng" /></div>
      <h3 class="exp-card-title">Skyeng</h3>
      <p class="exp-card-desc">{t("experience.skyeng")}</p>
    </article>
    <article class="exp-card exp-medialooks">
      <h3 class="exp-card-title">Medialooks</h3>
      <p class="exp-card-desc">{t("experience.medialooks")}</p>
    </article>
  </div>
</section>
