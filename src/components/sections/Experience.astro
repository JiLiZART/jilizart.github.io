---
import BrandLogos from "../BrandLogos.astro";
---
<section id="experience" class="section-spaced">
  <div class="eyebrow">Experience</div>
  <h2 class="h1" style="margin: 8px 0 36px;">Places I've helped build.</h2>

  <div class="exp-grid">
    <article class="exp-card exp-hodl">
      <div class="exp-card-logo"><BrandLogos brand="hodl" /></div>
      <h3 class="exp-card-title">HodlHodl</h3>
      <p class="exp-card-desc">Reimagined frontend infrastructure on top of Next.js — faster builds, cleaner data layer, a design system that scales with the team.</p>
    </article>
    <article class="exp-card exp-cube">
      <div class="exp-card-logo"><BrandLogos brand="cube" /></div>
      <h3 class="exp-card-title">Cube</h3>
      <p class="exp-card-desc">Built the UI Kit that backs Cube's SaaS console — tokens, primitives, patterns, docs.</p>
    </article>
    <article class="exp-card exp-muse">
      <div class="exp-card-logo" style="height: 22px;"><BrandLogos brand="muse" /></div>
      <h3 class="exp-card-title">Muse Group</h3>
      <p class="exp-card-desc">Musescore &amp; Ultimate Guitar — tablature rendering &amp; BBCode pipelines from seconds to 15&nbsp;ms.</p>
    </article>
    <article class="exp-card exp-skyeng">
      <div class="exp-card-logo" style="height: 18px;"><BrandLogos brand="skyeng" /></div>
      <h3 class="exp-card-title">Skyeng</h3>
      <p class="exp-card-desc">Built learner‑facing product surfaces for Russia's largest online English school.</p>
    </article>
    <article class="exp-card exp-medialooks">
      <h3 class="exp-card-title">Medialooks</h3>
      <p class="exp-card-desc">Designed single‑page applications for streaming and media‑production tooling.</p>
    </article>
  </div>
</section>
